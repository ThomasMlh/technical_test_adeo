{
  "name": "product-catalog",
  "private": true,
  "description": "Adeo technical test: PostgreSQL catalog (database/), its NestJS API (api/) and a Vue dashboard (front/)",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm --filter catalog-database db:setup",
    "start": "pnpm --parallel --filter api --filter front start",
    "start:dev": "pnpm --parallel --filter api --filter front start:dev",
    "start:api": "pnpm --filter api start",
    "start:front": "pnpm --filter front start",
    "db:start": "pnpm --filter catalog-database db:up",
    "db:stop": "pnpm --filter catalog-database db:stop",
    "db:migrate": "pnpm --filter catalog-database migrate",
    "db:reset": "pnpm --filter catalog-database seed",
    "test": "pnpm format:check && pnpm --recursive test && pnpm --filter api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  },
  "packageManager": "pnpm@12.23.0"
}
