{
  "name": "catalog-database",
  "version": "1.0.0",
  "private": true,
  "description": "Phase 1: local PostgreSQL, normalized catalog schema and seed from data/products.json",
  "type": "module",
  "exports": {
    "./testing": "./test/support/pglite-database.ts"
  },
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "db:up": "docker compose -f ../docker-compose.yml up -d --wait postgres",
    "db:stop": "docker compose -f ../docker-compose.yml stop postgres",
    "migrate": "tsx --env-file-if-exists=../.env src/migrate.ts",
    "migrate:revert": "tsx --env-file-if-exists=../.env ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "seed": "tsx --env-file-if-exists=../.env src/seed/seed.ts",
    "db:setup": "pnpm db:up && pnpm migrate && pnpm seed",
    "psql": "docker compose -f ../docker-compose.yml exec postgres psql -U catalog -d catalog",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
