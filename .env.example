# Copy to `.env` to override the defaults. Every variable is optional.
# Read by docker compose, the API and the database scripts.

# Port PostgreSQL is published on, on this machine.
POSTGRES_PORT=5432

# Database of the API and the database scripts: keep its port in line with POSTGRES_PORT.
DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog

# Port of the API.
PORT=3000

# Catalog loaded by the seed, relative to database/ or absolute.
CATALOG_FILE=../data/products.json
